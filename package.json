{
  "name": "@tmhs/screencast-mcp",
  "version": "0.43.0",
  "description": "Let AI agents record the Windows screen, watch it as frames, and edit it with ffmpeg",
  "mcpName": "io.github.TMHSDigital/screencast-mcp",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "screencast-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "author": "TMHSDigital",
  "license": "CC-BY-NC-ND-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TMHSDigital/screencast-mcp.git"
  },
  "homepage": "https://tmhsdigital.github.io/screencast-mcp/",
  "bugs": {
    "url": "https://github.com/TMHSDigital/screencast-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "claude",
    "screen-recording",
    "screen-capture",
    "screencast",
    "screenshot",
    "ffmpeg",
    "gif",
    "video-editing",
    "ocr",
    "redaction",
    "windows",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.3",
    "eslint": "^10.5.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.5"
  }
}
